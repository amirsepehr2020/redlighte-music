{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redlighte-music",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sitemap.xml", "/robots.txt"]
  },
  "d1_databases": [
    {
      "binding": "MUSIC_DB",
      "database_name": "prod-d1-tutorial",
      "database_id": "24e14d9f-76a7-4509-8e9e-119c20fd3cf7"
    }
  ]
}
